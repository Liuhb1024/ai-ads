# ==================== DMXAPI 配置 ====================
DMXAPI_BASE_URL=https://www.dmxapi.cn/v1
DMXAPI_API_KEY=your_dmxapi_key_here

# ==================== 默认文本模型 ====================
# DEFAULT_LLM_MODEL=claude-haiku-4-5-20251001
DEFAULT_LLM_MODEL=gpt-5.4-nano

# ==================== 视觉模型（关键帧分析） ====================
VISION_MODEL=gpt-5.4-nano

# ==================== 豆包视频理解（完整视频分析，通过 DMXAPI 代理） ====================
DOUBAO_VIDEO_MODEL=doubao-seed-2-0-lite-260215
DOUBAO_VIDEO_FPS=1.0

# ==================== 调用参数 ====================
LLM_TIMEOUT=120
LLM_MAX_RETRIES=1
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096
